# Example values

# Timezone
TZ=Europe/Zurich

# Pi-hole admin web UI password
PIHOLE_PASSWORD=yourpass

# Where your media library lives
MOVIES_PATH=/my/movies/path
MUSIC_PATH=/my/music/path

PUID=1000
PGID=1000

# vpn configuration
VPN_PROVIDER=myprovider
WIREGUARD_PRIVATE_KEY=**********************
WIREGUARD_ADDRESSES=mysubnet
SERVER_COUNTRIES=mycountries

LAN_SUBNET=mysubnet

#*******  Immich  ********

# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored
UPLOAD_LOCATION=/my/upload/location

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=/mydb/data/location
THUMB_LOCATION=/my/thumbnails/location

# The Immich version to use.
IMMICH_VERSION=v3

DB_PASSWORD=mypassword

DB_USERNAME=*******
DB_DATABASE_NAME=*******
